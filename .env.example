# ==================================================
# COMPUTERIZED PAYROLL MANAGEMENT SYSTEM - ENV CONFIG
# ==================================================

# Neon PostgreSQL Database Connection String (Server-side ONLY)
DATABASE_URL=postgresql://user:password@ep-example-poolerer.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT / Cookie Session Signing Secret Key
SESSION_SECRET=your_production_random_secret_key_change_in_vercel

# Secret key required if adding additional admin users after setup
INITIAL_ADMIN_SETUP_SECRET=your_initial_admin_setup_secret_key

# Node Environment
NODE_ENV=development
